<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.AdminController">
    <children>

        <!-- Background — opacity 0.82 giống UI.fxml / Profile.fxml -->
        <ImageView fitHeight="720.0" fitWidth="1280.0" opacity="0.82" pickOnBounds="true" preserveRatio="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <image><Image url="@/assets/background.jpg" /></image>
        </ImageView>

        <HBox spacing="0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <!-- ===== SIDEBAR — cùng style rgba semi-transparent như UI.fxml/Profile.fxml ===== -->
            <VBox minWidth="160.0" prefWidth="160.0" style="-fx-background-color: rgba(0,0,0,0.35); -fx-border-color: rgba(255,255,255,0.12); -fx-border-width: 0 1 0 0;">
                <children>

                    <!-- Logo -->
                    <VBox alignment="CENTER" spacing="4.0" style="-fx-padding: 20 10 16 10; -fx-border-color: rgba(255,255,255,0.10); -fx-border-width: 0 0 1 0;">
                        <children>
                            <Label text="🏆 ĐẤU GIÁ" textFill="#e2ff00">
                                <font><Font name="System Bold" size="17.0" /></font>
                            </Label>
                            <Label text="ADMIN PANEL" textFill="rgba(255,255,255,0.70)">
                                <font><Font name="System Bold" size="11.0" /></font>
                            </Label>
                        </children>
                    </VBox>

                    <!-- Nav buttons -->
                    <VBox spacing="4.0" style="-fx-padding: 12 8 12 8;">
                        <children>
                            <Button fx:id="btnDashboard" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleShowDashboard" style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-alignment: CENTER-LEFT; -fx-padding: 10 14; -fx-background-radius: 6; -fx-cursor: hand;" text="📊  Dashboard">
                                <font><Font name="System Bold" size="13.0" /></font>
                            </Button>
                        </children>
                    </VBox>

                    <Region VBox.vgrow="ALWAYS" />

                    <!-- Logout — dùng rgba + border-radius giống UI.fxml/Profile.fxml -->
                    <VBox style="-fx-padding: 12 8 16 8; -fx-border-color: rgba(255,255,255,0.10); -fx-border-width: 1 0 0 0;">
                        <children>
                            <Button fx:id="btnLogout" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleLogout" style="-fx-background-color: rgba(180,30,30,0.55); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 10 14; -fx-border-color: rgba(255,255,255,0.15); -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="ĐĂNG XUẤT">
                                <font><Font name="System Bold" size="13.0" /></font>
                            </Button>
                        </children>
                    </VBox>

                </children>
            </VBox>

            <!-- ===== MAIN CONTENT — transparent để thấy background, giống UI.fxml ===== -->
            <VBox spacing="16.0" style="-fx-padding: 20 20 20 20;" HBox.hgrow="ALWAYS">
                <children>

                    <!-- Top bar -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <children>
                            <Label text="ADMIN DASHBOARD" textFill="#e2ff00">
                                <font><Font name="System Bold" size="18.0" /></font>
                            </Label>
                            <Region HBox.hgrow="ALWAYS" />
                            <!-- Search — border-radius: 6 giống TextField ở UI.fxml/Profile.fxml -->
                            <TextField fx:id="txtSearchAdmin" prefHeight="38.0" prefWidth="300.0" promptText="🔍  Tìm user / sản phẩm..." style="-fx-background-color: rgba(255,255,255,0.92); -fx-border-color: transparent; -fx-background-radius: 6; -fx-border-radius: 6; -fx-text-fill: #1a1a2e; -fx-prompt-text-fill: rgba(0,0,0,0.35); -fx-font-size: 13px; -fx-padding: 0 12;">
                                <font><Font name="Corbel Italic" size="13.0" /></font>
                            </TextField>
                        </children>
                    </HBox>

                    <!-- Stat cards — dùng rgba semi-transparent giống card trong các màn khác -->
                    <HBox spacing="14.0">
                        <children>
                            <VBox prefHeight="90.0" prefWidth="190.0" spacing="4.0" style="-fx-background-color: rgba(0,0,0,0.30); -fx-background-radius: 10; -fx-padding: 14 16 14 16; -fx-border-color: rgba(34,211,238,0.30); -fx-border-radius: 10; -fx-border-width: 1;">
                                <children>
                                    <Label text="TỔNG NGƯỜI DÙNG" textFill="#888888">
                                        <font><Font size="11.0" /></font>
                                    </Label>
                                    <Label fx:id="lblTotalUsers" text="0" textFill="#22d3ee">
                                        <font><Font name="System Bold" size="34.0" /></font>
                                    </Label>
                                </children>
                            </VBox>
                            <VBox prefHeight="90.0" prefWidth="190.0" spacing="4.0" style="-fx-background-color: rgba(0,0,0,0.30); -fx-background-radius: 10; -fx-padding: 14 16 14 16; -fx-border-color: rgba(245,158,11,0.30); -fx-border-radius: 10; -fx-border-width: 1;">
                                <children>
                                    <Label text="CHỜ DUYỆT" textFill="#888888">
                                        <font><Font size="11.0" /></font>
                                    </Label>
                                    <Label fx:id="lblPending" text="0" textFill="#f59e0b">
                                        <font><Font name="System Bold" size="34.0" /></font>
                                    </Label>
                                </children>
                            </VBox>
                            <VBox prefHeight="90.0" prefWidth="190.0" spacing="4.0" style="-fx-background-color: rgba(0,0,0,0.30); -fx-background-radius: 10; -fx-padding: 14 16 14 16; -fx-border-color: rgba(74,222,128,0.30); -fx-border-radius: 10; -fx-border-width: 1;">
                                <children>
                                    <Label text="ĐANG DIỄN RA" textFill="#888888">
                                        <font><Font size="11.0" /></font>
                                    </Label>
                                    <Label fx:id="lblLive" text="0" textFill="#4ade80">
                                        <font><Font name="System Bold" size="34.0" /></font>
                                    </Label>
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <!-- Bảng Người dùng -->
                    <VBox spacing="8.0" style="-fx-background-color: rgba(0,0,0,0.30); -fx-background-radius: 10; -fx-padding: 14 16 14 16; -fx-border-color: rgba(255,255,255,0.10); -fx-border-radius: 10; -fx-border-width: 1;" VBox.vgrow="ALWAYS">
                        <children>
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <children>
                                    <Label text="NGƯỜI DÙNG" textFill="#22d3ee">
                                        <font><Font name="System Bold" size="14.0" /></font>
                                    </Label>
                                    <Label fx:id="lblUserCount" text="(0)" textFill="#888888">
                                        <font><Font size="12.0" /></font>
                                    </Label>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button mnemonicParsing="false" onAction="#handleRefreshUsers" style="-fx-background-color: rgba(255,255,255,0.10); -fx-text-fill: #cccccc; -fx-background-radius: 4; -fx-border-color: rgba(255,255,255,0.20); -fx-border-width: 1; -fx-border-radius: 4; -fx-padding: 5 12; -fx-cursor: hand;" text="↻ Làm mới" />
                                </children>
                            </HBox>
                            <TableView fx:id="tableUsers" prefHeight="149.0" prefWidth="1046.0" style="-fx-background-color: transparent; -fx-border-color: rgba(255,255,255,0.10); -fx-border-radius: 6;" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colUserName" prefWidth="220" text="Email" />
                                    <TableColumn fx:id="colUsername" prefWidth="150" text="Username" />
                                    <TableColumn fx:id="colRole" prefWidth="100" text="Vai trò" />
                                    <TableColumn fx:id="colBalance" prefWidth="140" text="Số dư" />
                                    <TableColumn fx:id="colUserAction" prefWidth="110" text="Thao tác" />
                                </columns>
                            </TableView>
                        </children>
                    </VBox>

                    <!-- Bảng Chờ duyệt + Live (2 cột) -->
                    <HBox prefHeight="250.0" spacing="14.0">
                        <children>

                            <!-- Chờ duyệt -->
                            <VBox prefHeight="198.0" prefWidth="483.0" spacing="8.0" style="-fx-background-color: rgba(0,0,0,0.30); -fx-background-radius: 10; -fx-padding: 14 16 14 16; -fx-border-color: rgba(255,255,255,0.10); -fx-border-radius: 10; -fx-border-width: 1;" HBox.hgrow="ALWAYS">
                                <children>
                                    <HBox alignment="CENTER_LEFT" prefHeight="63.0" prefWidth="442.0" spacing="10.0">
                                        <children>
                                            <Label text="CHỜ DUYỆT" textFill="#f59e0b">
                                                <font><Font name="System Bold" size="14.0" /></font>
                                            </Label>
                                            <Label fx:id="lblPendingCount" text="(0)" textFill="#888888">
                                                <font><Font size="12.0" /></font>
                                            </Label>
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Button mnemonicParsing="false" onAction="#handleRefreshPending" style="-fx-background-color: rgba(255,255,255,0.10); -fx-text-fill: #cccccc; -fx-background-radius: 4; -fx-border-color: rgba(255,255,255,0.20); -fx-border-width: 1; -fx-border-radius: 4; -fx-padding: 5 10; -fx-cursor: hand;" text="↻" />
                                        </children>
                                    </HBox>
                                    <TableView fx:id="tablePending" style="-fx-background-color: transparent; -fx-border-color: rgba(255,255,255,0.10); -fx-border-radius: 6;" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colPendingItem" prefWidth="160" text="Sản phẩm" />
                                            <TableColumn fx:id="colPendingSeller" prefWidth="110" text="Seller" />
                                            <TableColumn fx:id="colPendingPrice" prefWidth="110" text="Giá khởi" />
                                            <TableColumn fx:id="colPendingAction" prefWidth="150" text="Thao tác" />
                                        </columns>
                                    </TableView>
                                </children>
                            </VBox>

                            <!-- Đang diễn ra -->
                            <VBox spacing="8.0" style="-fx-background-color: rgba(0,0,0,0.30); -fx-background-radius: 10; -fx-padding: 14 16 14 16; -fx-border-color: rgba(255,255,255,0.10); -fx-border-radius: 10; -fx-border-width: 1;" HBox.hgrow="ALWAYS">
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <children>
                                            <Label text="ĐANG DIỄN RA" textFill="#4ade80">
                                                <font><Font name="System Bold" size="14.0" /></font>
                                            </Label>
                                            <Label fx:id="lblLiveCount" text="(0 live)" textFill="#888888">
                                                <font><Font size="12.0" /></font>
                                            </Label>
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Button mnemonicParsing="false" onAction="#handleRefreshLive" style="-fx-background-color: rgba(255,255,255,0.10); -fx-text-fill: #cccccc; -fx-background-radius: 4; -fx-border-color: rgba(255,255,255,0.20); -fx-border-width: 1; -fx-border-radius: 4; -fx-padding: 5 10; -fx-cursor: hand;" text="↻" />
                                        </children>
                                    </HBox>
                                    <TableView fx:id="tableLiveAuctions" style="-fx-background-color: transparent; -fx-border-color: rgba(255,255,255,0.10); -fx-border-radius: 6;" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colLiveItem" prefWidth="140" text="Sản phẩm" />
                                            <TableColumn fx:id="colLiveSeller" prefWidth="100" text="Seller" />
                                            <TableColumn fx:id="colLivePrice" prefWidth="120" text="Giá hiện tại" />
                                            <TableColumn fx:id="colLiveBids" prefWidth="80" text="Lượt bid" />
                                            <TableColumn fx:id="colLiveTime" prefWidth="90" text="Còn lại" />
                                        </columns>
                                    </TableView>
                                </children>
                            </VBox>

                        </children>
                    </HBox>

                </children>
            </VBox>

        </HBox>
    </children>
</AnchorPane>