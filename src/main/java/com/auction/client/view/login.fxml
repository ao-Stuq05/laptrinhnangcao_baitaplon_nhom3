<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="540.0" prefWidth="960.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.LoginController">
   <children>

      <ImageView fitHeight="540.0" fitWidth="960.0" opacity="0.88" pickOnBounds="true" preserveRatio="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <image>
            <Image url="@/assets/background.jpg" />
         </image>
      </ImageView>

      <VBox alignment="CENTER" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>

            <VBox alignment="CENTER" spacing="6.0">
               <children>
                  <Label alignment="CENTER" maxWidth="900.0" text="Welcome To" textFill="#f8ff03">
                     <font><Font name="Bauhaus 93" size="24.0" /></font>
                  </Label>
                  <Label alignment="CENTER" maxWidth="900.0" text="AUCTION SYSTEM" textFill="#ffdd00">
                     <font><Font name="Book Antiqua Bold" size="30.0" /></font>
                  </Label>
               </children>
            </VBox>

            <VBox alignment="CENTER" spacing="14.0" style="-fx-background-color: rgba(0,0,0,0.30);                          -fx-background-radius: 14; -fx-border-radius: 14;                          -fx-padding: 28 36 28 36;">
               <children>

                  <VBox alignment="CENTER" spacing="5.0">
                     <children>
                        <Label prefHeight="18.0" prefWidth="376.0" text="Account" textFill="WHITE">
                           <font><Font name="Droid Sans" size="15.0" /></font>
                        </Label>
                        <TextField fx:id="txtAccount" alignment="TOP_LEFT" maxWidth="380.0" prefHeight="42.0" prefWidth="380.0" promptText="Fill Your Account" style="-fx-background-color: rgba(255,255,255,0.92); -fx-border-color: rgba(255,255,255,0.25); -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #1a1a2e; -fx-prompt-text-fill: rgba(0,0,0,0.35); -fx-font-size: 14px; -fx-padding: 0 12;">
                           <font><Font name="Corbel Italic" size="15.0" /></font>
                        </TextField>
                     </children>
                  </VBox>

                  <VBox alignment="CENTER" spacing="5.0">
                     <children>
                        <Label prefHeight="18.0" prefWidth="376.0" text="PassWord" textFill="WHITE">
                           <font><Font name="Droid Sans" size="15.0" /></font>
                        </Label>
                        <PasswordField fx:id="txtPassword" alignment="TOP_LEFT" maxWidth="380.0" prefHeight="42.0" promptText="Fill Your Password" style="-fx-background-color: rgba(255,255,255,0.92); -fx-border-color: rgba(255,255,255,0.25); -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #1a1a2e; -fx-prompt-text-fill: rgba(0,0,0,0.35); -fx-font-size: 14px; -fx-padding: 0 12;">
                           <font><Font name="Corbel Italic" size="15.0" /></font>
                        </PasswordField>
                     </children>
                  </VBox>

                  <Label fx:id="lblError" style="-fx-text-fill: #ff6b6b; -fx-font-size: 12px;" visible="false" />

                  <Button mnemonicParsing="false" onAction="#handleLogin" prefHeight="42.0" prefWidth="380.0" style="-fx-background-color: #e2ff00; -fx-text-fill: #0a1e30;                                  -fx-font-weight: bold; -fx-font-size: 14px;                                  -fx-border-color: transparent; -fx-border-width: 0;                                  -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;" text="LOGIN">
                     <font><Font name="System Bold" size="14.0" /></font>
                  </Button>

                  <Button mnemonicParsing="false" onAction="#handleGoRegister" prefHeight="31.0" prefWidth="380.0" style="-fx-background-color: transparent; -fx-font-style: italic;" text="Chưa có tài khoản? Đăng ký ngay" textFill="rgba(226,255,0,0.70)">
                     <font><Font name="System Bold" size="15.0" /></font>
                  </Button>

               </children>
            </VBox>

         </children>
      </VBox>

   </children>
</AnchorPane>
