<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="680.0" prefWidth="1180.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controller.ProductController">
    <children>

        <!-- Ảnh nền -->
        <ImageView fitHeight="680.0" fitWidth="1180.0" opacity="0.82"
                   pickOnBounds="true" preserveRatio="false"
                   AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <image>
                <Image url="@/assets/background.jpg" />
            </image>
        </ImageView>

        <!-- Root HBox: sidebar + nội dung -->
        <HBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>

                <!-- ═══════════════ SIDEBAR ═══════════════ -->
                <VBox prefWidth="160.0" minWidth="160.0"
                      style="-fx-background-color: rgba(0,0,0,0.35);
                             -fx-border-color: rgba(255,255,255,0.12);
                             -fx-border-width: 0 1 0 0;">
                    <children>

                        <!-- Logo -->
                        <VBox alignment="CENTER" spacing="4.0"
                              style="-fx-padding: 20 10 16 10;
                                     -fx-border-color: rgba(255,255,255,0.10);
                                     -fx-border-width: 0 0 1 0;">
                            <children>
                                <Label text="🏆 ĐẤU GIÁ" textFill="#e2ff00">
                                    <font><Font name="System Bold" size="17.0" /></font>
                                </Label>
                                <Label text="TRỰC TUYẾN" textFill="rgba(255,255,255,0.70)">
                                    <font><Font name="System Bold" size="11.0" /></font>
                                </Label>
                            </children>
                        </VBox>

                        <!-- Nav -->
                        <VBox spacing="4.0" style="-fx-padding: 12 8 12 8;">
                            <children>
                                <Button maxWidth="Infinity" mnemonicParsing="false"
                                        onAction="#handleGoHome" text="Home"
                                        style="-fx-background-color: transparent;
                                               -fx-text-fill: white; -fx-font-size: 13px;
                                               -fx-font-weight: bold; -fx-alignment: CENTER-LEFT;
                                               -fx-padding: 10 14; -fx-cursor: hand;" />

                                <Button maxWidth="Infinity" mnemonicParsing="false"
                                        onAction="#handleGoProfile" text="Hồ sơ"
                                        style="-fx-background-color: transparent;
                                               -fx-text-fill: white; -fx-font-size: 13px;
                                               -fx-font-weight: bold; -fx-alignment: CENTER-LEFT;
                                               -fx-padding: 10 14; -fx-cursor: hand;" />

                                <Button fx:id="btnMyAuction" maxWidth="Infinity"
                                        mnemonicParsing="false"
                                        onAction="#handleGoMyAuction" text="Đấu giá tôi"
                                        visible="false" managed="false"
                                        style="-fx-background-color: transparent;
                                               -fx-text-fill: white; -fx-font-size: 13px;
                                               -fx-font-weight: bold; -fx-alignment: CENTER-LEFT;
                                               -fx-padding: 10 14; -fx-cursor: hand;" />

                                <Button fx:id="btnSellProduct" maxWidth="Infinity"
                                        mnemonicParsing="false"
                                        onAction="#handleGoCreateAuction"
                                        text="+ Đăng bán SP"
                                        visible="false" managed="false"
                                        style="-fx-background-color: rgba(226,255,0,0.10);
                                               -fx-text-fill: #e2ff00; -fx-font-size: 13px;
                                               -fx-font-weight: bold; -fx-alignment: CENTER-LEFT;
                                               -fx-padding: 10 14;
                                               -fx-border-color: rgba(226,255,0,0.45);
                                               -fx-border-width: 0 0 0 3;
                                               -fx-background-radius: 0 6 6 0;
                                               -fx-cursor: hand;" />
                            </children>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <!-- Logout -->
                        <VBox style="-fx-padding: 12 8 16 8;
                                     -fx-border-color: rgba(255,255,255,0.10);
                                     -fx-border-width: 1 0 0 0;">
                            <children>
                                <Button maxWidth="Infinity" mnemonicParsing="false"
                                        onAction="#handleLogout" text="ĐĂNG XUẤT"
                                        style="-fx-background-color: rgba(180,30,30,0.55);
                                               -fx-text-fill: white; -fx-font-weight: bold;
                                               -fx-font-size: 13px; -fx-padding: 10 14;
                                               -fx-border-color: rgba(255,255,255,0.15);
                                               -fx-border-width: 1; -fx-border-radius: 6;
                                               -fx-background-radius: 6; -fx-cursor: hand;" />
                            </children>
                        </VBox>

                    </children>
                </VBox>

                <!-- ═══════════════ NỘI DUNG CHÍNH ═══════════════ -->
                <VBox spacing="14.0"
                      style="-fx-padding: 18 18 18 18;"
                      HBox.hgrow="ALWAYS">
                    <children>

                        <!-- Header: nút quay lại + tiêu đề -->
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#handleGoBack"
                                        text="← Quay lại"
                                        style="-fx-background-color: rgba(255,255,255,0.10);
                                               -fx-text-fill: white;
                                               -fx-border-color: rgba(255,255,255,0.20);
                                               -fx-border-radius: 4; -fx-background-radius: 4;
                                               -fx-cursor: hand; -fx-padding: 6 12;" />
                                <Label text="CHI TIẾT SẢN PHẨM" textFill="#e2ff00">
                                    <font><Font name="System Bold" size="18.0" /></font>
                                </Label>
                            </children>
                        </HBox>

                        <!-- Body: 3 cột -->
                        <HBox spacing="14.0" VBox.vgrow="ALWAYS">
                            <children>

                                <!-- ── CỘT TRÁI: ảnh + thông tin + đếm ngược ── -->
                                <VBox prefWidth="230.0" minWidth="220.0" spacing="10.0">
                                    <children>

                                        <!-- Ảnh sản phẩm -->
                                        <VBox alignment="CENTER" prefHeight="160.0"
                                              style="-fx-background-color: rgba(255,255,255,0.10);
                                                     -fx-border-color: rgba(226,255,0,0.28);
                                                     -fx-background-radius: 12;
                                                     -fx-border-radius: 12;
                                                     -fx-border-width: 1.5; -fx-padding: 10;">
                                            <ImageView fx:id="imgProduct"
                                                       fitHeight="130.0" fitWidth="200.0"
                                                       pickOnBounds="true" preserveRatio="true">
                                                <image>
                                                    <Image url="@/assets/background.jpg" />
                                                </image>
                                            </ImageView>
                                        </VBox>

                                        <!-- Thông tin sản phẩm -->
                                        <GridPane hgap="8.0" vgap="10.0"
                                                  style="-fx-background-color: rgba(255,255,255,0.10);
                                                         -fx-border-color: rgba(226,255,0,0.28);
                                                         -fx-background-radius: 12;
                                                         -fx-border-radius: 12;
                                                         -fx-border-width: 1.5; -fx-padding: 12;">
                                            <columnConstraints>
                                                <ColumnConstraints hgrow="SOMETIMES" minWidth="75.0" />
                                                <ColumnConstraints halignment="RIGHT" hgrow="ALWAYS" />
                                            </columnConstraints>
                                            <rowConstraints>
                                                <RowConstraints />
                                                <RowConstraints />
                                                <RowConstraints />
                                                <RowConstraints />
                                                <RowConstraints />
                                            </rowConstraints>
                                            <children>
                                                <Label text="Tên vật phẩm:" textFill="rgba(226,255,0,0.75)"
                                                       GridPane.columnIndex="0" GridPane.rowIndex="0">
                                                    <font><Font size="12.0" /></font>
                                                </Label>
                                                <Label fx:id="lblProductName" text="—" textFill="WHITE"
                                                       GridPane.columnIndex="1" GridPane.rowIndex="0">
                                                    <font><Font name="System Bold" size="13.0" /></font>
                                                </Label>

                                                <Label text="Danh mục:" textFill="rgba(226,255,0,0.75)"
                                                       GridPane.columnIndex="0" GridPane.rowIndex="1">
                                                    <font><Font size="12.0" /></font>
                                                </Label>
                                                <Label fx:id="lblCategory" text="—" textFill="WHITE"
                                                       GridPane.columnIndex="1" GridPane.rowIndex="1">
                                                    <font><Font name="System Bold" size="13.0" /></font>
                                                </Label>

                                                <Label text="Mô tả:" textFill="rgba(226,255,0,0.75)"
                                                       GridPane.columnIndex="0" GridPane.rowIndex="2"
                                                       GridPane.valignment="TOP">
                                                    <font><Font size="12.0" /></font>
                                                </Label>
                                                <Label fx:id="lblDescription" text="—" textFill="rgba(255,255,255,0.85)"
                                                       wrapText="true" maxWidth="120.0"
                                                       GridPane.columnIndex="1" GridPane.rowIndex="2">
                                                    <font><Font size="12.0" /></font>
                                                </Label>

                                                <Label text="Giá khởi điểm:" textFill="rgba(226,255,0,0.75)"
                                                       GridPane.columnIndex="0" GridPane.rowIndex="3">
                                                    <font><Font size="12.0" /></font>
                                                </Label>
                                                <Label fx:id="lblStartPrice" text="—" textFill="WHITE"
                                                       GridPane.columnIndex="1" GridPane.rowIndex="3">
                                                    <font><Font name="System Bold" size="13.0" /></font>
                                                </Label>

                                                <Label text="Trạng thái:" textFill="rgba(226,255,0,0.75)"
                                                       GridPane.columnIndex="0" GridPane.rowIndex="4">
                                                    <font><Font size="12.0" /></font>
                                                </Label>
                                                <Label fx:id="lblStatus" text="● Đang mở bán"
                                                       textFill="#00ff88"
                                                       GridPane.columnIndex="1" GridPane.rowIndex="4">
                                                    <font><Font name="System Bold" size="13.0" /></font>
                                                </Label>
                                            </children>
                                        </GridPane>

                                        <!-- Đếm ngược -->
                                        <VBox alignment="CENTER" spacing="6.0"
                                              style="-fx-background-color: rgba(255,255,255,0.10);
                                                     -fx-border-color: rgba(226,255,0,0.28);
                                                     -fx-background-radius: 12;
                                                     -fx-border-radius: 12;
                                                     -fx-border-width: 1.5; -fx-padding: 12;">
                                            <Label text="⏱ THỜI GIAN CÒN LẠI"
                                                   textFill="rgba(226,255,0,0.75)">
                                                <font><Font name="System Bold" size="11.0" /></font>
                                            </Label>
                                            <HBox alignment="CENTER" spacing="8.0">
                                                <Label fx:id="lblHours" text="00" textFill="#e2ff00">
                                                    <font><Font name="System Bold" size="32.0" /></font>
                                                </Label>
                                                <Label text=":" textFill="WHITE">
                                                    <font><Font name="System Bold" size="26.0" /></font>
                                                </Label>
                                                <Label fx:id="lblMinutes" text="00" textFill="#e2ff00">
                                                    <font><Font name="System Bold" size="32.0" /></font>
                                                </Label>
                                                <Label text=":" textFill="WHITE">
                                                    <font><Font name="System Bold" size="26.0" /></font>
                                                </Label>
                                                <Label fx:id="lblSeconds" text="00" textFill="#e2ff00">
                                                    <font><Font name="System Bold" size="32.0" /></font>
                                                </Label>
                                            </HBox>
                                        </VBox>

                                    </children>
                                </VBox>

                                <!-- ── CỘT GIỮA: LineChart đồ thị giá ── -->
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                                    <children>

                                        <!-- Tiêu đề đồ thị -->
                                        <HBox alignment="CENTER_LEFT" spacing="10.0"
                                              style="-fx-padding: 0 0 2 0;">
                                            <Label text="📈 BIỂU ĐỒ GIÁ ĐẤU THEO THỜI GIAN THỰC"
                                                   textFill="#e2ff00">
                                                <font><Font name="System Bold" size="12.0" /></font>
                                            </Label>
                                            <Label text="Cập nhật: realtime" textFill="rgba(255,255,255,0.45)">
                                                <font><Font size="10.0" /></font>
                                            </Label>
                                        </HBox>

                                        <!-- LineChart JavaFX -->
                                        <VBox VBox.vgrow="ALWAYS"
                                              style="-fx-background-color: rgba(255,255,255,0.06);
                                                     -fx-border-color: rgba(226,255,0,0.25);
                                                     -fx-background-radius: 12;
                                                     -fx-border-radius: 12;
                                                     -fx-border-width: 1.5;
                                                     -fx-padding: 10 10 6 4;">
                                            <LineChart fx:id="bidChart"
                                                       animated="false"
                                                       legendVisible="false"
                                                       VBox.vgrow="ALWAYS"
                                                       style="-fx-background-color: transparent;">
                                                <xAxis>
                                                    <CategoryAxis fx:id="chartXAxis"
                                                                  label=""
                                                                  tickLabelRotation="-45"
                                                                  style="-fx-tick-label-fill: rgba(255,255,255,0.55);
                                                                         -fx-tick-label-font-size: 9px;" />
                                                </xAxis>
                                                <yAxis>
                                                    <NumberAxis fx:id="chartYAxis"
                                                                label=""
                                                                style="-fx-tick-label-fill: rgba(255,255,255,0.55);
                                                                       -fx-tick-label-font-size: 9px;" />
                                                </yAxis>
                                            </LineChart>
                                        </VBox>

                                        <!-- Giá hiện tại (bên dưới chart) -->
                                        <VBox alignment="CENTER"
                                              style="-fx-background-color: rgba(226,255,0,0.06);
                                                     -fx-border-color: #e2ff00;
                                                     -fx-border-radius: 8;
                                                     -fx-background-radius: 8;
                                                     -fx-border-width: 1.5;
                                                     -fx-padding: 10 16;">
                                            <Label text="GIÁ HIỆN TẠI CAO NHẤT"
                                                   textFill="rgba(226,255,0,0.75)">
                                                <font><Font size="11.0" /></font>
                                            </Label>
                                            <Label fx:id="lblCurrentPrice" text="—" textFill="#e2ff00">
                                                <font><Font name="System Bold" size="26.0" /></font>
                                            </Label>
                                        </VBox>

                                    </children>
                                </VBox>

                                <!-- ── CỘT PHẢI: đặt giá + top 5 ── -->
                                <VBox prefWidth="260.0" minWidth="245.0" spacing="10.0">
                                    <children>

                                        <!-- Panel đặt giá -->
                                        <VBox spacing="10.0"
                                              style="-fx-background-color: rgba(255,255,255,0.10);
                                                     -fx-border-color: rgba(226,255,0,0.28);
                                                     -fx-background-radius: 12;
                                                     -fx-border-radius: 12;
                                                     -fx-border-width: 1.5;
                                                     -fx-padding: 14;">
                                            <Label text="ĐẶT GIÁ ĐẤU" textFill="WHITE">
                                                <font><Font name="System Bold" size="14.0" /></font>
                                            </Label>

                                            <!-- Số dư inline (chỉ Bidder) -->
                                            <HBox fx:id="paneBalanceInline" alignment="CENTER_LEFT"
                                                  managed="false" spacing="6.0" visible="false">
                                                <Label text="Số dư của bạn:"
                                                       textFill="rgba(226,255,0,0.75)">
                                                    <font><Font size="12.0" /></font>
                                                </Label>
                                                <Label fx:id="lblBalanceInline" text="0 đ"
                                                       textFill="#00ff88">
                                                    <font><Font name="System Bold" size="12.0" /></font>
                                                </Label>
                                            </HBox>

                                            <!-- Input + nút đấu giá -->
                                            <HBox spacing="8.0">
                                                <TextField fx:id="txtBidAmount"
                                                           prefHeight="36.0"
                                                           promptText="Nhập mức giá..."
                                                           style="-fx-background-color: rgba(255,255,255,0.92);
                                                                  -fx-border-color: transparent;
                                                                  -fx-background-radius: 4;
                                                                  -fx-font-size: 13px;"
                                                           HBox.hgrow="ALWAYS" />
                                                <Button onAction="#handleBid" prefHeight="36.0"
                                                        text="ĐẤU GIÁ"
                                                        style="-fx-background-color: #0d3d6e;
                                                               -fx-text-fill: white;
                                                               -fx-font-weight: bold;
                                                               -fx-border-color: rgba(255,255,255,0.25);
                                                               -fx-border-radius: 4;
                                                               -fx-background-radius: 4;
                                                               -fx-cursor: hand;" />
                                            </HBox>

                                            <Label fx:id="lblBidError"
                                                   style="-fx-text-fill: #ff6b6b; -fx-font-size: 12px;"
                                                   visible="false" wrapText="true" />
                                        </VBox>

                                        <!-- Top 5 giá cao nhất -->
                                        <VBox spacing="8.0" VBox.vgrow="ALWAYS"
                                              style="-fx-background-color: rgba(255,255,255,0.10);
                                                     -fx-border-color: rgba(226,255,0,0.28);
                                                     -fx-background-radius: 12;
                                                     -fx-border-radius: 12;
                                                     -fx-border-width: 1.5;
                                                     -fx-padding: 14;">
                                            <!-- Header -->
                                            <HBox alignment="CENTER_LEFT" spacing="0.0">
                                                <children>
                                                    <Label text="🏆 TOP 5 GIÁ CAO NHẤT"
                                                           textFill="#e2ff00">
                                                        <font><Font name="System Bold" size="12.0" /></font>
                                                    </Label>
                                                </children>
                                            </HBox>

                                            <!-- Hàng tiêu đề -->
                                            <HBox spacing="6.0"
                                                  style="-fx-padding: 0 4 4 4;
                                                         -fx-border-color: rgba(255,255,255,0.15);
                                                         -fx-border-width: 0 0 1 0;">
                                                <Label prefWidth="30.0" text="Hạng"
                                                       textFill="rgba(255,255,255,0.45)">
                                                    <font><Font size="10.0" /></font>
                                                </Label>
                                                <Label text="Người đặt" textFill="rgba(255,255,255,0.45)"
                                                       HBox.hgrow="ALWAYS">
                                                    <font><Font size="10.0" /></font>
                                                </Label>
                                                <Label text="Giá" textFill="rgba(255,255,255,0.45)">
                                                    <font><Font size="10.0" /></font>
                                                </Label>
                                            </HBox>

                                            <!-- Danh sách top 5 (được populate bởi controller) -->
                                            <VBox fx:id="bidHistoryBox" spacing="4.0"
                                                  VBox.vgrow="ALWAYS" />
                                        </VBox>

                                    </children>
                                </VBox>

                            </children>
                        </HBox>

                    </children>
                </VBox>

            </children>
        </HBox>

    </children>
</AnchorPane>