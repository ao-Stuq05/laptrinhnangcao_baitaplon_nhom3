<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="680.0" prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controller.UIController">
    <children>

        <ImageView fitHeight="680.0" fitWidth="1100.0" opacity="0.82"
                   pickOnBounds="true" preserveRatio="false"
                   AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <image>
                <Image url="@/assets/background.jpg" />
            </image>
        </ImageView>

        <HBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>

                <!-- SIDEBAR -->
                <VBox prefWidth="160.0" minWidth="160.0"
                      style="-fx-background-color: rgba(0,0,0,0.35); -fx-border-color: rgba(255,255,255,0.12); -fx-border-width: 0 1 0 0;">
                    <children>

                        <!-- Logo -->
                        <VBox alignment="CENTER" spacing="4.0" style="-fx-padding: 20 10 16 10; -fx-border-color: rgba(255,255,255,0.10); -fx-border-width: 0 0 1 0;">
                            <children>
                                <Label maxWidth="205.0" text="🏆 ĐẤU GIÁ" textFill="#e2ff00">
                                    <font><Font name="System Bold" size="17.0" /></font>
                                </Label>
                                <Label maxWidth="205.0" text="TRỰC TUYẾN" textFill="rgba(255,255,255,0.70)">
                                    <font><Font name="System Bold" size="11.0" /></font>
                                </Label>
                            </children>
                        </VBox>
                        <!-- Số dư (chỉ Bidder) -->
                        <VBox fx:id="paneBalance" alignment="CENTER" spacing="2.0"
                              style="-fx-padding: 10 10 10 10; -fx-background-color: rgba(226,255,0,0.06); -fx-border-color: rgba(226,255,0,0.25); -fx-border-width: 0 0 1 0;"
                              visible="false" managed="false">
                            <children>
                                <Label text="Số dư" textFill="rgba(255,255,255,0.55)">
                                    <font><Font size="10.0" /></font>
                                </Label>
                                <Label fx:id="lblBalance" text="0 đ" textFill="#e2ff00">
                                    <font><Font name="System Bold" size="13.0" /></font>
                                </Label>
                            </children>
                        </VBox>

                        <!-- Nav buttons -->
                        <VBox spacing="4.0" style="-fx-padding: 12 8 12 8;">
                            <children>
                                <Button maxWidth="Infinity" mnemonicParsing="false"
                                        text="Home"
                                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-alignment: CENTER-LEFT; -fx-padding: 10 14; -fx-background-radius: 6; -fx-cursor: hand;" />

                                <Button maxWidth="Infinity" mnemonicParsing="false"
                                        onAction="#handleGoProfile"
                                        text="Hồ sơ"
                                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-alignment: CENTER-LEFT; -fx-padding: 10 14; -fx-cursor: hand;" />

                                <Button fx:id="btnMyAuction" maxWidth="Infinity" mnemonicParsing="false"
                                        onAction="#handleGoMyAuction"
                                        text="Đấu giá tôi"
                                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-alignment: CENTER-LEFT; -fx-padding: 10 14; -fx-cursor: hand;" />

                                <!-- Đăng bán SP — ẩn nếu không phải Seller -->
                                <Button fx:id="btnSellProduct" maxWidth="Infinity" mnemonicParsing="false"
                                        onAction="#handleGoProductSeller"
                                        text="+ Đăng bán SP"
                                        visible="false" managed="false"
                                        style="-fx-background-color: rgba(226,255,0,0.10); -fx-text-fill: #e2ff00; -fx-font-size: 13px; -fx-font-weight: bold; -fx-alignment: CENTER-LEFT; -fx-padding: 10 14; -fx-border-color: rgba(226,255,0,0.45); -fx-border-width: 0 0 0 3; -fx-background-radius: 0 6 6 0; -fx-cursor: hand;" />


                            </children>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <!-- Logout -->
                        <VBox style="-fx-padding: 12 8 16 8; -fx-border-color: rgba(255,255,255,0.10); -fx-border-width: 1 0 0 0;">
                            <children>
                                <Button onAction="#handleLogout" maxWidth="Infinity" mnemonicParsing="false"
                                        text="ĐĂNG XUẤT"
                                        style="-fx-background-color: rgba(180,30,30,0.55); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 10 14; -fx-border-color: rgba(255,255,255,0.15); -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" />
                            </children>
                        </VBox>

                    </children>
                </VBox>

                <!-- NỘI DUNG CHÍNH -->
                <VBox spacing="14.0" style="-fx-padding: 20 20 20 20;" HBox.hgrow="ALWAYS">
                    <children>

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <TextField fx:id="txtSearch" prefHeight="38.0"
                                           promptText="Nhập tên vật phẩm..."
                                           style="-fx-background-color: rgba(255,255,255,0.92); -fx-border-color: transparent; -fx-background-radius: 6; -fx-border-radius: 6; -fx-font-size: 13px; -fx-padding: 0 12;"
                                           HBox.hgrow="ALWAYS" />
                                <ComboBox fx:id="cbFilter" prefHeight="38.0" prefWidth="130.0"
                                          promptText="Filter"
                                          style="-fx-background-color: rgba(255,255,255,0.92); -fx-border-color: transparent; -fx-background-radius: 6; -fx-font-size: 13px;" />
                            </children>
                        </HBox>

                        <Label text="DANH SÁCH ĐẤU GIÁ" textFill="#e2ff00">
                            <font><Font name="System Bold" size="15.0" /></font>
                        </Label>

                        <GridPane fx:id="gridAuctions" hgap="14.0" vgap="14.0" VBox.vgrow="ALWAYS">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33" />
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33" />
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33" />
                            </columnConstraints>
                        </GridPane>

                        <!-- PAGINATION — nút « » có onAction, hboxPageButtons inject động -->
                        <HBox alignment="CENTER" spacing="8.0">
                            <children>
                                <Button fx:id="btnPrev" mnemonicParsing="false" text="«"
                                        onAction="#handlePrev"
                                        visible="false" managed="false"
                                        style="-fx-background-color: rgba(255,255,255,0.10); -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.20); -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-cursor: hand; -fx-min-width: 32; -fx-min-height: 32;" />

                                <!-- Các nút số trang được tạo động bởi UIController -->
                                <HBox fx:id="hboxPageButtons" spacing="6.0" alignment="CENTER"
                                      visible="false" managed="false"/>

                                <Button fx:id="btnNext" mnemonicParsing="false" text="»"
                                        onAction="#handleNext"
                                        visible="false" managed="false"
                                        style="-fx-background-color: rgba(255,255,255,0.10); -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.20); -fx-border-width: 1; -fx-border-radius: 4; -fx-background-radius: 4; -fx-cursor: hand; -fx-min-width: 32; -fx-min-height: 32;" />
                            </children>
                        </HBox>

                    </children>
                </VBox>

            </children>
        </HBox>

    </children>
</AnchorPane>