<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="680.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.ProfileController">
    <children>

        <!-- ẢNH NỀN -->
        <ImageView fitHeight="680.0" fitWidth="1100.0" opacity="0.82" pickOnBounds="true" preserveRatio="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <image>
                <Image url="@/assets/background.jpg" />
            </image>
        </ImageView>

        <HBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>

                <!-- ===== SIDEBAR ===== -->
                <VBox prefWidth="160.0" minWidth="160.0" style="-fx-background-color: rgba(0,0,0,0.35); -fx-border-color: rgba(255,255,255,0.12); -fx-border-width: 0 1 0 0;">
                    <children>

                        <!-- Logo -->
                        <VBox alignment="CENTER" spacing="4.0" style="-fx-padding: 20 10 16 10; -fx-border-color: rgba(255,255,255,0.10); -fx-border-width: 0 0 1 0;">
                            <children>
                                <Label maxWidth="205.0" text="🏆 ĐẤU GIÁ" textFill="#e2ff00">
                                    <font><Font name="System Bold" size="17.0" /></font>
                                </Label>
                                <Label maxWidth="205.0" text="TRỰC TUYẾN" textFill="rgba(255,255,255,0.70)">
                                    <font><Font name="System Bold" size="11.0" /></font>
                                </Label>
                            </children>
                        </VBox>

                        <!-- Nav -->
                        <VBox spacing="4.0" style="-fx-padding: 12 8 12 8;">
                            <children>
                                <Button maxWidth="Infinity" mnemonicParsing="false"
                                        onAction="#handleGoHome"
                                        text="Home"
                                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-alignment: CENTER-LEFT; -fx-padding: 10 14; -fx-cursor: hand;" />

                                <Button maxWidth="Infinity" mnemonicParsing="false"
                                        text="Hồ sơ cá nhân"
                                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-alignment: CENTER-LEFT; -fx-padding: 10 14; -fx-background-radius: 6; -fx-cursor: hand;" />

                                <Button fx:id="btnMyAuction" maxWidth="Infinity" mnemonicParsing="false"
                                        onAction="#handleGoMyAuction"
                                        text="Đấu giá tôi"
                                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-alignment: CENTER-LEFT; -fx-padding: 10 14; -fx-cursor: hand;" />

                                <Button fx:id="btnSellProduct" maxWidth="Infinity" mnemonicParsing="false"
                                        onAction="#handleGoProductSeller"
                                        text="+ Đăng bán SP"
                                        style="-fx-background-color: rgba(226,255,0,0.10); -fx-text-fill: #e2ff00; -fx-font-size: 13px; -fx-font-weight: bold; -fx-alignment: CENTER-LEFT; -fx-padding: 10 14; -fx-border-color: rgba(226,255,0,0.45); -fx-border-width: 0 0 0 3; -fx-background-radius: 0 6 6 0; -fx-cursor: hand;" />

                            </children>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <!-- Logout -->
                        <VBox style="-fx-padding: 12 8 16 8; -fx-border-color: rgba(255,255,255,0.10); -fx-border-width: 1 0 0 0;">
                            <children>
                                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleLogout" style="-fx-background-color: rgba(180,30,30,0.55); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 10 14; -fx-border-color: rgba(255,255,255,0.15); -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="ĐĂNG XUẤT" />
                            </children>
                        </VBox>

                    </children>
                </VBox>

                <!-- ===== NỘI DUNG CHÍNH ===== -->
                <VBox spacing="12.0" style="-fx-padding: 18 18 18 18;" HBox.hgrow="ALWAYS">
                    <children>

                        <!-- Header -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#handleGoBack" style="-fx-background-color: rgba(255,255,255,0.10); -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.20); -fx-border-radius: 4; -fx-background-radius: 4; -fx-cursor: hand; -fx-padding: 6 12;" text="← Quay lại" />
                                <Label text="HỒ SƠ CÁ NHÂN" textFill="#e2ff00">
                                    <font><Font name="System Bold" size="18.0" /></font>
                                </Label>

                                <!-- Menu ... -->
                                <Region HBox.hgrow="ALWAYS" />
                                <Button mnemonicParsing="false" style="-fx-background-color: rgba(255,255,255,0.10); -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.20); -fx-border-radius: 4; -fx-background-radius: 4; -fx-cursor: hand; -fx-padding: 4 10;" text="···" />
                            </children>
                        </HBox>

                        <!-- Body: 2 cột -->
                        <HBox spacing="14.0" VBox.vgrow="ALWAYS">
                            <children>

                                <!-- ===== CỘT TRÁI: avatar + số dư + nạp tiền ===== -->
                                <VBox prefWidth="260.0" spacing="10.0">
                                    <children>

                                        <!-- Avatar card -->
                                        <VBox alignment="CENTER" spacing="8.0" style="-fx-background-color: rgba(255,255,255,0.10); -fx-border-color: rgba(226,255,0,0.28); -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-padding: 20 16 16 16;">
                                            <children>

                                                <!-- Avatar circle -->
                                                <StackPane maxHeight="80.0" maxWidth="80.0" prefHeight="80.0" prefWidth="80.0">
                                                    <children>
                                                        <Circle radius="40.0" style="-fx-fill: #1a3a5c; -fx-stroke: #e2ff00; -fx-stroke-width: 2.5;" />
                                                        <Label fx:id="lblAvatarInitials" text="NN" textFill="#e2ff00">
                                                            <font><Font name="System Bold" size="26.0" /></font>
                                                        </Label>
                                                    </children>
                                                </StackPane>

                                                <!-- Tên -->
                                                <Label fx:id="lblFullName" text="Nguyễn Nhóm 3" textFill="WHITE">
                                                    <font><Font name="System Bold" size="14.0" /></font>
                                                </Label>

                                                <!-- Badge vai trò -->
                                                <HBox alignment="CENTER">
                                                    <children>
                                                        <Label fx:id="lblRole" style="-fx-background-color: rgba(0,200,100,0.18); -fx-text-fill: #00ff88; -fx-border-color: rgba(0,200,100,0.40); -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 1; -fx-padding: 2 10; -fx-font-size: 11px; -fx-font-weight: bold;" text="● Seller" />
                                                    </children>
                                                </HBox>

                                                <!-- Ngày tham gia -->
                                                <Label fx:id="lblJoinDate" text="Tham gia: 14/04/2025" textFill="rgba(255,255,255,0.50)">
                                                    <font><Font size="11.0" /></font>
                                                </Label>

                                            </children>
                                        </VBox>

                                        <!-- ===== SỐ DƯ & NẠP TIỀN ===== -->
                                        <VBox spacing="10.0" style="-fx-background-color: rgba(255,255,255,0.10); -fx-border-color: rgba(226,255,0,0.30); -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 14 14 14 14;">
                                            <children>

                                                <Label text="💰  SỐ DƯ TÀI KHOẢN" textFill="#e2ff00">
                                                    <font><Font name="System Bold" size="12.0" /></font>
                                                </Label>

                                                <!-- Hiển thị số dư -->
                                                <VBox alignment="CENTER" spacing="2.0" style="-fx-background-color: rgba(226,255,0,0.06); -fx-border-color: rgba(226,255,0,0.20); -fx-border-radius: 6; -fx-background-radius: 6; -fx-border-width: 1; -fx-padding: 10;">
                                                    <children>
                                                        <Label text="Số dư hiện tại" textFill="rgba(226,255,0,0.75)">
                                                            <font><Font size="11.0" /></font>
                                                        </Label>
                                                        <Label fx:id="lblBalance" text="5,000,000 đ" textFill="#e2ff00">
                                                            <font><Font name="System Bold" size="20.0" /></font>
                                                        </Label>
                                                    </children>
                                                </VBox>

                                                <!-- Separator -->
                                                <Label text="─────  Nạp tiền  ─────" textFill="rgba(255,255,255,0.25)">
                                                    <font><Font size="10.0" /></font>
                                                </Label>

                                                <!-- Input nạp tiền -->
                                                <VBox spacing="5.0">
                                                    <children>
                                                        <Label text="Số tiền nạp (đ)" textFill="rgba(226,255,0,0.75)">
                                                            <font><Font size="11.0" /></font>
                                                        </Label>
                                                        <TextField fx:id="txtTopUpAmount" prefHeight="32.0" promptText="VD: 500000" style="-fx-background-color: rgba(255,255,255,0.92); -fx-border-color: rgba(226,255,0,0.40); -fx-border-width: 1.5; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-size: 13px; -fx-padding: 0 10;" />
                                                    </children>
                                                </VBox>

                                                <!-- Gợi ý nhanh -->
                                                <HBox alignment="CENTER" spacing="5.0">
                                                    <children>
                                                        <Button mnemonicParsing="false" onAction="#handleQuickTopUp100k" style="-fx-background-color: rgba(255,255,255,0.10); -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.20); -fx-border-radius: 4; -fx-background-radius: 4; -fx-cursor: hand; -fx-font-size: 11px; -fx-padding: 4 6;" text="+ 100,000đ">
                                                            <font><Font size="11.0" /></font>
                                                        </Button>
                                                        <Button mnemonicParsing="false" onAction="#handleQuickTopUp500k" style="-fx-background-color: rgba(255,255,255,0.10); -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.20); -fx-border-radius: 4; -fx-background-radius: 4; -fx-cursor: hand; -fx-font-size: 11px; -fx-padding: 4 6;" text="+ 500,000đ">
                                                            <font><Font size="11.0" /></font>
                                                        </Button>
                                                        <Button mnemonicParsing="false" onAction="#handleQuickTopUp1m" style="-fx-background-color: rgba(255,255,255,0.10); -fx-text-fill: white; -fx-border-color: rgba(255,255,255,0.20); -fx-border-radius: 4; -fx-background-radius: 4; -fx-cursor: hand; -fx-font-size: 11px; -fx-padding: 4 6;" text="+ 1,000,000đ">
                                                            <font><Font size="11.0" /></font>
                                                        </Button>
                                                    </children>
                                                </HBox>

                                                <!-- Lỗi nạp tiền -->
                                                <Label fx:id="lblTopUpError" text="" textFill="#ff6b6b" visible="false" wrapText="true">
                                                    <font><Font size="11.0" /></font>
                                                </Label>

                                                <!-- Nút nạp -->
                                                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleTopUp" style="-fx-background-color: #0d3d6e; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 9 14; -fx-border-color: rgba(255,255,255,0.25); -fx-border-width: 1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="NẠP TIỀN">
                                                    <font><Font name="System Bold" size="13.0" /></font>
                                                </Button>

                                            </children>
                                        </VBox>

                                    </children>
                                </VBox>

                                <!-- ===== CỘT PHẢI: thông tin + lịch sử ===== -->
                                <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                                    <children>

                                        <!-- Thông tin cơ bản -->
                                        <VBox spacing="12.0" style="-fx-background-color: rgba(255,255,255,0.10); -fx-border-color: rgba(226,255,0,0.28); -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-padding: 16;">
                                            <children>

                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <children>
                                                        <Label text="THÔNG TIN CƠ BẢN" textFill="#e2ff00">
                                                            <font><Font name="System Bold" size="13.0" /></font>
                                                        </Label>
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Button fx:id="btnEdit" mnemonicParsing="false" onAction="#handleEditProfile" style="-fx-background-color: #0d3d6e; -fx-text-fill: white; -fx-font-size: 12px; -fx-border-color: rgba(255,255,255,0.25); -fx-border-radius: 4; -fx-background-radius: 4; -fx-cursor: hand; -fx-padding: 5 12;" text="✎  Chỉnh sửa" />
                                                    </children>
                                                </HBox>

                                                <!-- Họ và Tên -->
                                                <VBox spacing="4.0">
                                                    <children>
                                                        <Label text="Họ và Tên" textFill="rgba(226,255,0,0.75)">
                                                            <font><Font size="11.0" /></font>
                                                        </Label>
                                                        <TextField fx:id="txtFullName" prefHeight="36.0" style="-fx-background-color: rgba(255,255,255,0.92); -fx-border-color: rgba(226,255,0,0.40); -fx-border-width: 1.5; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-size: 13px; -fx-padding: 0 12;" text="Nguyễn Nhóm 3" />
                                                    </children>
                                                </VBox>

                                                <!-- ID tài khoản -->
                                                <VBox spacing="4.0">
                                                    <children>
                                                        <Label text="ID tài khoản" textFill="rgba(226,255,0,0.75)">
                                                            <font><Font size="11.0" /></font>
                                                        </Label>
                                                        <TextField fx:id="txtUsername" editable="false" prefHeight="36.0" style="-fx-background-color: rgba(255,255,255,0.40); -fx-border-color: rgba(226,255,0,0.20); -fx-border-width: 1.5; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-size: 13px; -fx-padding: 0 12; -fx-text-fill: #888;" text="nhom3_user" />
                                                    </children>
                                                </VBox>

                                                <!-- Gmail -->
                                                <VBox spacing="4.0">
                                                    <children>
                                                        <Label text="Gmail" textFill="rgba(226,255,0,0.75)">
                                                            <font><Font size="11.0" /></font>
                                                        </Label>
                                                        <TextField fx:id="txtEmail" prefHeight="36.0" style="-fx-background-color: rgba(255,255,255,0.92); -fx-border-color: rgba(226,255,0,0.40); -fx-border-width: 1.5; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-size: 13px; -fx-padding: 0 12;" text="nhom3@gmail.com" />
                                                    </children>
                                                </VBox>

                                                <!-- Mật khẩu -->
                                                <VBox spacing="4.0">
                                                    <children>
                                                        <Label text="Mật khẩu" textFill="rgba(226,255,0,0.75)">
                                                            <font><Font size="11.0" /></font>
                                                        </Label>
                                                        <PasswordField fx:id="txtPassword" prefHeight="36.0" style="-fx-background-color: rgba(255,255,255,0.92); -fx-border-color: rgba(226,255,0,0.40); -fx-border-width: 1.5; -fx-background-radius: 8; -fx-border-radius: 8; -fx-font-size: 13px; -fx-padding: 0 12;" text="••••••••••" />
                                                    </children>
                                                </VBox>

                                                <!-- Lỗi / thành công -->
                                                <Label fx:id="lblProfileMsg" text="" textFill="#00ff88" visible="false" wrapText="true">
                                                    <font><Font size="12.0" /></font>
                                                </Label>

                                            </children>
                                        </VBox>

                                        <!-- Lịch sử đấu giá -->
                                        <VBox spacing="8.0" style="-fx-background-color: rgba(255,255,255,0.10); -fx-border-color: rgba(226,255,0,0.28); -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-padding: 14;" VBox.vgrow="ALWAYS">
                                            <children>

                                                <Label text="LỊCH SỬ ĐẤU GIÁ" textFill="#e2ff00">
                                                    <font><Font name="System Bold" size="13.0" /></font>
                                                </Label>

                                                <!-- Tab switch -->
                                                <HBox spacing="0.0">
                                                    <children>
                                                        <Button fx:id="btnTabSell" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleTabSell" style="-fx-background-color: #0d3d6e; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 7 18; -fx-background-radius: 4 0 0 4; -fx-border-radius: 4 0 0 4; -fx-cursor: hand;" text="Lịch sử đăng bán" HBox.hgrow="ALWAYS" />
                                                        <Button fx:id="btnTabBuy" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleTabBuy" style="-fx-background-color: rgba(255,255,255,0.10); -fx-text-fill: rgba(255,255,255,0.65); -fx-font-size: 12px; -fx-padding: 7 18; -fx-background-radius: 0 4 4 0; -fx-border-radius: 0 4 4 0; -fx-cursor: hand;" text="Lịch sử mua" HBox.hgrow="ALWAYS" />
                                                    </children>
                                                </HBox>

                                                <!-- Bảng lịch sử -->
                                                <TableView fx:id="tableHistory" style="-fx-background-color: transparent; -fx-border-color: rgba(255,255,255,0.12); -fx-border-radius: 4; -fx-table-cell-border-color: rgba(255,255,255,0.08);" VBox.vgrow="ALWAYS">

                                                    <columns>
                                                        <TableColumn fx:id="colProduct" prefWidth="195.0" text="Sản phẩm" />
                                                        <TableColumn fx:id="colStartPrice" prefWidth="135.0" text="Giá khởi điểm" />
                                                        <TableColumn fx:id="colFinalPrice" prefWidth="135.0" text="Giá cuối" />
                                                        <TableColumn fx:id="colWinner" prefWidth="125.0" text="Người thắng" />
                                                        <TableColumn fx:id="colEndDate" prefWidth="135.0" text="Ngày kết thúc" />
                                                    </columns>

                                                    <placeholder>
                                                        <Label text="Chưa có dữ liệu" textFill="rgba(255,255,255,0.40)">
                                                            <font><Font size="12.0" /></font>
                                                        </Label>
                                                    </placeholder>

                                                </TableView>

                                            </children>
                                        </VBox>

                                    </children>
                                </VBox>

                            </children>
                        </HBox>

                    </children>
                </VBox>

            </children>
        </HBox>

    </children>
</AnchorPane>
